TOKEN=telegram:token
CHATID=-1234
ADMIN_CHATID=-1234
DEBUG=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_USER=default
REDIS_MUTEX=random-value
DEV_CHAT=

# 1688 Hot Product Scanner
PUSH_CHAT_ID=
SCAN_CRON=0 */3 * * * *
COOLDOWN_HOURS=6
PUSH_THRESHOLD=30
MAX_PAGES=1

# ============================================
# 1688 爬虫增强配置
# ============================================

# --- 住宅代理提供商 (Residential Proxy) ---
# 1688 对 IP 封禁较严，建议使用住宅代理
# 配置任一提供商即可，优先级: BrightData > Oxylabs > IPRoyal > Soax > Smartproxy

# BrightData (formerly Luminati)
# BRIGHTDATA_HOST=zproxy.lum-superproxy.io
# BRIGHTDATA_PORT=22225
# BRIGHTDATA_USER=your-username
# BRIGHTDATA_PASS=your-password
# BRIGHTDATA_REGION=jp  # jp=日本, cn=中国, hk=香港

# Oxylabs
# OXYLABS_USER=your-username
# OXYLABS_PASS=your-password
# OXYLABS_COUNTRY=jp

# IPRoyal
# IPROYAL_USER=your-username
# IPROYAL_PASS=your-password
# IPROYAL_COUNTRY=jp

# Soax (SOCKS5)
# SOAX_USER=your-username
# SOAX_PASS=your-password
# SOAX_COUNTRY=jp

# Smartproxy
# SMARTPROXY_USER=your-username
# SMARTPROXY_PASS=your-password
# SMARTPROXY_COUNTRY=jp

# --- 静态代理池 (备用) ---
# 逗号分隔多个代理，格式: protocol://user:pass@host:port
# PROXY_POOL=http://user1:pass1@proxy1:8080,http://user2:pass2@proxy2:8080

# --- 请求频率控制 ---
# REQUEST_DELAY=3000  # 请求间隔(毫秒)，默认3000
# MAX_RETRIES=3       # 最大重试次数，默认3

# --- Playwright 配置 ---
# PLAYWRIGHT_HEADLESS=true  # 无头模式，默认true
